# Python
__pycache__/
*.py[cod]
*$py.class

# Distribution
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Python Cache
.pytest_cache/
.mypy_cache/

# Logs
logs/
*.log

# Models
# The deployable bundle models/fraud_risk_model.joblib IS committed (the
# Streamlit app needs it); intermediate model files are not.
models/*.pkl
models/*.joblib
models/*.bin
!models/fraud_risk_model.joblib
models/base_models/

# Reports
# metrics.json, *_curve.csv and *_importance.csv are committed for the app.
reports/*.pdf
reports/*.html

# Processed Data
data/processed/*
!data/processed/.gitkeep

# Raw Data
# The IEEE-CIS dataset is downloaded from Kaggle (see README), not committed.
data/raw/*
!data/raw/.gitkeep

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Environment
.env

# Temporary Files
*.tmp
*.bak

# Coverage
.coverage
htmlcov/

# Misc
*.swp
